# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# Get your MongoDB URI from https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── Auth ─────────────────────────────────────────────────────────────────────
# A strong random secret string for signing JWTs
JWT_SECRET=your_strong_jwt_secret_here

# ─── Razorpay ─────────────────────────────────────────────────────────────────
# Get these from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ─── Platform Config ──────────────────────────────────────────────────────────
PLATFORM_SETUP_SECRET=change_this_to_a_strong_random_string

# ─── CORS (Frontend URL) ──────────────────────────────────────────────────────
# In production, set this to your deployed frontend URL (e.g. Vercel URL)
# Leave empty for local development
CORS_ORIGIN=
